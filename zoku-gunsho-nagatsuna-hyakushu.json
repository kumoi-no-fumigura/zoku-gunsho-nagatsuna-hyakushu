   ]
  },
  {
   "id": "zoku-gunsho-nagatsuna-hyakushu-0020",
   "pid": "nao-4395150",
   "pages": [
    21
   ],
   "text": "一此一巻之始返報之詞花麗也歌之裏書寺祖父京極中納言入道は名明は定家卿法真華無疑候一往事嘉禄二年九月十七日今者嘉暦二年二日月廿三日拝見之返し哀になつかしく存候てへたてつるむかしの程の水くきはそも流て涙とそなる人のおやの親のかきけることの葉を子の子の世まてみるもおつかし暁月数白判康安二年丑八月廿日書写之権正僧都良春判",
   "poems": [
    "104"
   ]
  }
 ],
 "poems": [
  {
   "seq": "1",
   "text": "わせと御裏に申候如此御歌をふるはみたる物の清候て",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-4395150",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "2",
   "text": "候へハ御覧御心にも作者の御心にも神妙に申たると",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-4395150",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "3",
   "text": "と見候詞なひくとして歌すかたよくならせ給へく",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-4395150",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "4",
   "text": "候なり只春夏秋冬と申度はよみよく候聊も文字",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-4395150",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "5",
   "text": "あまた候題の哥はあるへき様と申物也それを近代",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-4395150",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "6",
   "text": "はる雨のふるや岡への松か枝にのこるともおき去年の白雪",
   "kana": "",
   "speaker": "散位長綱",
   "page": 5,
   "pid": "nao-4395150",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "早春雨",
   "kotobagaki": ""
  },
  {
   "seq": "7",
   "text": "はる雨のふるや岡への松か枝にのこるともおき去年の白雪",
   "kana": "",
   "speaker": "散位長綱",
   "page": 6,
   "pid": "nao-4395150",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "早春雨",
   "kotobagaki": ""
  },
  {
   "seq": "8",
   "text": "こほりいる谷の小水とけやしてたゑ〳〵出る春のしからみ",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-4395150",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "一御歌体宜候仍合点但早春雨と申題をはかたは読ましきと存候也只春夏秋冬なと申題は此躰よくひ読歎と申物は其題をよむ様と申初候一也早春雨はまはしかくしはみなにすへき物に候はねはたゝ又はちに雨のふると計読候也岡へ残置と申さむ題にはいさゝかも難あるましき歌にて候也残置"
  },
  {
   "seq": "9",
   "text": "青柳の緑やいつこ山風に雪よりかくる春のしらいと",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-4395150",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "霊中柳",
   "kotobagaki": ""
  },
  {
   "seq": "10",
   "text": "一たか代より匂ひそめけん巻もくのひちらの軒の春の梅かへ",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-4395150",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "縁やいつこ残る神妙ひ山風にそすこし心えすひ風前には雪とまりかたしや候はん庭梅"
  },
  {
   "seq": "11",
   "text": "尋行ふもとの野へも跡たえてかすむあなたは山の端もなし",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-4395150",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "庭の梅の類は只一条大宮の景気にてひすらにつくりたる家と申とはつらかすきこゑ候なりせ様のにくはみたることはしはしめも見せすしたるかよく候也深霞"
  },
  {
   "seq": "12",
   "text": "年をへて口影もしらぬ草の店春のゆかりのかに妻らん",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-4395150",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "草庵虚",
   "kotobagaki": ""
  },
  {
   "seq": "13",
   "text": "見よしのゝ吉野ゝ瀧もよそにのみ霞の遠くの春の明ほの",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-4395150",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "水辺霞",
   "kotobagaki": ""
  },
  {
   "seq": "14",
   "text": "一花の色もけさたえ〳〵に暮のこゑをへかすむ雲の岩橋",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-4395150",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "心は相叶下旬に詞すみしなりあはすひの字く候いたくた候歟橋辺営"
  },
  {
   "seq": "15",
   "text": "一尋行花もいく重の諸たへて庭にもるゝ普風うゑ",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-4395150",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "一霞題三首まて相連傍に橋辺暮と申題には可可被交候歟是は橋辺裏によみつく候也旅鶯"
  },
  {
   "seq": "16",
   "text": "春雨の名残の軒そかほるなる月待里の梅の下かせ",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-4395150",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "旅営はたゝ路外に行路暮の鳴たるよくも候也花露横入て候也尋花は旅と申へくも候はぬなり御歌さまは優に候待春月"
  },
  {
   "seq": "17",
   "text": "梅か枝を夜半の嵐やこつらんあれたる窓に匂ふ月影",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-4395150",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "これは雨後梅を詠歌候也窓春月"
  },
  {
   "seq": "18",
   "text": "かへるかり霞のそこに行なみやたえ〳〵夜中の雲に鳴なり",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-4395150",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "これも御歌優候梅花薫夜窓にて候也春窓〽ほと申春の字はすこしもまはしかくさすはゝ春と二文字にすへられ候へく候帰雁"
  },
  {
   "seq": "19",
   "text": "久かたの空行月の立明に花よりもるゝかつらたの山",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-4395150",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "あしくも候はす候妻底に行なやみとてまた雲に鳴とひ霞の庭に雲のあるましきにては候はねと天象の物のおほく大切なるやうに候也暁花"
  },
  {
   "seq": "20",
   "text": "山風に四方の霞を分すてゝ花にうつろふ春の夜の月",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-4395150",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "これも奇すかたはやさしくよく候暁花のあまりに深山にふかゝらすとも候ぬへきなり花前月"
  },
  {
   "seq": "21",
   "text": "春のきる桜の衣匂ふなり霞の下のあふ坂のやま",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-4395150",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "さたまりたる題をそはにすてゝあらぬものをなかくとをかれ候間歌の半を外人の領して下句に題のなかはかりましり候か心得す候也只二句に題のはいはれなく候名所花"
  },
  {
   "seq": "22",
   "text": "難波江や桜吹まき行風に花のなこそつはかのゆほの",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-4395150",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "一御体神体神妙妙熊此辺坂の山させる相坂の要事も候はぬ所にはてきて候也関路とも不申なにゝあふ坂ともその故もなくて名所はかりには何の理にも見え候はぬ物なり江上花"
  },
  {
   "seq": "23",
   "text": "袖の上にしはし宿かる花の色をありと心風の又さそふらん",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-4395150",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "落花",
   "kotobagaki": ""
  },
  {
   "seq": "24",
   "text": "くれて行春のかたみに鶯の帰るさしたふみ山辺のとと",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-4395150",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "鳥帰",
   "kotobagaki": ""
  },
  {
   "seq": "25",
   "text": "行春をしたひかねてやをく露の野原の草も恨かほなる",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-4395150",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "一春草",
   "kotobagaki": ""
  },
  {
   "seq": "26",
   "text": "かたみとや風もやおらむ桜花春は暮にし春日のゝ原",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-4395150",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "をく露の野原の草つつきすこし心えすひ原上余花"
  },
  {
   "seq": "27",
   "text": "卯花のちるてふをのゝ山おろしに遣ひしきそふる谷の夕風",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-4395150",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "問居卯花",
   "kotobagaki": ""
  },
  {
   "seq": "28",
   "text": "月影の心をさそふ穴に又なきすてゝ行本とゝきす哉",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-4395150",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "上旬に山山おろしとて下旬に風候へからす各替なからたゝおなしものにて候へし同前時馬"
  },
  {
   "seq": "29",
   "text": "一時馬夕浪かけて五月雨のふる川のへになかぬ日はなし",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-4395150",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "河郭公此題はあしく被出て候也題の字も書つゝくるゆへありもこそ出題は候はんすれと題を見たるに物に心えたるこゝちよく候へ千鳥こそ河千鳥とては候へ時鳥不水謀河辺聞時鳥とこそ候はめ水郷郭公"
  },
  {
   "seq": "30",
   "text": "夏ふかき野寺に風やれすらん草者になひく入相のか",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-4395150",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "此時間もつゝきて水郷も非普通題白と白鷺小尾なと申物の様に水に付られ候心得候はす候古寺夏草"
  },
  {
   "seq": "31",
   "text": "見しま江や誰を恨で夏士の暮れはもゆるからひなるさん",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-4395150",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "一鐘声の草葉になひきなとし候事亡父殊違有の物に候へはえほめ候はす候名所煎"
  },
  {
   "seq": "32",
   "text": "したにのみ思ふ心をみたらしのなかきもきよきとふ蛍哉",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-4395150",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "かららてもゆる理不可有候へは殊に申ならはして恨てもゆると申事さたまりたる様ひ社預堂"
  },
  {
   "seq": "33",
   "text": "一古郷の軒のあやめの朝しめりこれもむかしの香に匂ひけり",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-4395150",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "朝菖蒲",
   "kotobagaki": ""
  },
  {
   "seq": "34",
   "text": "にほの御や風とはなしに五月雨のふるにも春の色はみへけり",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "nao-4395150",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "湖五月雨",
   "kotobagaki": ""
  },
  {
   "seq": "35",
   "text": "五月雨に野中の松の陰長なしぬれつゝゆかん道遠とも",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "nao-4395150",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "春虫色宜意心元候はす候一樹五月雨"
  },
  {
   "seq": "36",
   "text": "鳴蝉の度は秋にちかつきてかねてうつろふ森の下草",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "nao-4395150",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "木の五月雨も題の面いはれなく候樹陰なとや候らむ分は無難山家蝉"
  },
  {
   "seq": "37",
   "text": "うき枕涼くなりぬから衣袖しの浦に秋やちかつく",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "nao-4395150",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "一題ハ山家也御歌ハ林非山家候平地に木多生た類を林と申山に家作りたるを山家と申事替候貞貞"
  },
  {
   "seq": "38",
   "text": "風の音も物そかなしきさら枕ひと夜のふしに秋や来らん",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "nao-4395150",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "晩夏枕",
   "kotobagaki": ""
  },
  {
   "seq": "39",
   "text": "一谷の戸のふりても月の有明に軒もの松にかゝる白雲",
   "kana": "",
   "speaker": "",
   "page": 13,
   "pid": "nao-4395150",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "月前夜",
   "kotobagaki": ""
  },
  {
   "seq": "40",
   "text": "露源た山分衣風過てならはぬ袖に月そなかるゝ",
   "kana": "",
   "speaker": "",
   "page": 13,
   "pid": "nao-4395150",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "秋の題に月前余に候へはいとゝ廿日月に読なされ候はゝ秋二十首の始に書候てや候へき谷戸と別に要用も候はす月歌にはかまへても雲をあはせしとこそ読候へ白雲の月本意候行路月"
  },
  {
   "seq": "41",
   "text": "森の露吹はらふ竹の葉にやとれる月の色そつれなき",
   "kana": "",
   "speaker": "",
   "page": 13,
   "pid": "nao-4395150",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "なかるゝやあまりに候へき此字ふか程此間月"
  },
  {
   "seq": "42",
   "text": "なかむれは心も空に行月の出きの小嶋に影そかたふく",
   "kana": "",
   "speaker": "",
   "page": 13,
   "pid": "nao-4395150",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "嶋上月",
   "kotobagaki": ""
  },
  {
   "seq": "43",
   "text": "夕露のまかきの薄たか、世より月をあるしとおもひそめけん",
   "kana": "",
   "speaker": "",
   "page": 13,
   "pid": "nao-4395150",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "籬頭月",
   "kotobagaki": ""
  },
  {
   "seq": "44",
   "text": "高砂の松の風のみ身にしみて霧にたゝよふあまの釣舟",
   "kana": "",
   "speaker": "",
   "page": 13,
   "pid": "nao-4395150",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "海上霧",
   "kotobagaki": ""
  },
  {
   "seq": "45",
   "text": "吹風も秋のけしきのもりの露うつかひそむか霧の下草",
   "kana": "",
   "speaker": "",
   "page": 13,
   "pid": "nao-4395150",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "杜間霧",
   "kotobagaki": ""
  },
  {
   "seq": "46",
   "text": "夏かりの玉郷のあしのわか草に浪よりのちの秋の夕きり",
   "kana": "",
   "speaker": "",
   "page": 13,
   "pid": "nao-4395150",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "江霧",
   "kotobagaki": ""
  },
  {
   "seq": "47",
   "text": "さほ鹿の入る野のま萩末よはみしからみすてゝ月に鳴なり",
   "kana": "",
   "speaker": "",
   "page": 14,
   "pid": "nao-4395150",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "ことはつゝきはよく候あしの若葉いかゝ候へからん夜萩"
  },
  {
   "seq": "48",
   "text": "一夕雪はたれ詩わひて花薄野中の水になみたか類らん",
   "kana": "",
   "speaker": "",
   "page": 14,
   "pid": "nao-4395150",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "詞すかたよくつゝきて候夜萩と申題はいかさまも夜字をおかれ候へかし月にとて夜をかくしよまれて候ふか然候鹿又よこ入て候水辺薄"
  },
  {
   "seq": "49",
   "text": "秋もまた浅茅か原の蘭むかしを問ハ度そこほるゝ",
   "kana": "",
   "speaker": "",
   "page": 14,
   "pid": "nao-4395150",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "草花",
   "kotobagaki": ""
  },
  {
   "seq": "50",
   "text": "夕暮は月まつ山も吹たえて霧のあなたに初度のこえ",
   "kana": "",
   "speaker": "",
   "page": 14,
   "pid": "nao-4395150",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "梅か香に昔をとへは春の月と申歌の後昔をとへは一毎人読れ候也か様善悪六七十歳以後大かき歌はとりはたらかさるましき物にて候山雁"
  },
  {
   "seq": "51",
   "text": "ひとり住軒はの山のゆふ暮は鳴ぬもさそなさを鹿の意",
   "kana": "",
   "speaker": "",
   "page": 14,
   "pid": "nao-4395150",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "鹿声近",
   "kotobagaki": ""
  },
  {
   "seq": "52",
   "text": "一住なれし跡をや秋もしたふらん人のまかたに松長の声",
   "kana": "",
   "speaker": "",
   "page": 14,
   "pid": "nao-4395150",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "声ちかたになかぬとては声不審隣家虫"
  },
  {
   "seq": "53",
   "text": "とひ人のひとりふり行夜の面に庭の蓬生あとや見ゆらん",
   "kana": "",
   "speaker": "",
   "page": 15,
   "pid": "nao-4395150",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "庭上両",
   "kotobagaki": ""
  },
  {
   "seq": "54",
   "text": "秋の夜の月の都の明にして松風すさみ衣うつなり",
   "kana": "",
   "speaker": "",
   "page": 15,
   "pid": "nao-4395150",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "庭上雨非秋題候歟松下擣衣"
  },
  {
   "seq": "55",
   "text": "一散つ日か庭もまかきももみち葉のはらふかたなき秋の山里",
   "kana": "",
   "speaker": "",
   "page": 15,
   "pid": "nao-4395150",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "如前題在下二勺紅葉多"
  },
  {
   "seq": "56",
   "text": "一白雲の立田の太くの山の葉く人にしられぬ花葉ちるよし",
   "kana": "",
   "speaker": "",
   "page": 15,
   "pid": "nao-4395150",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "雲陽紅葉",
   "kotobagaki": ""
  },
  {
   "seq": "57",
   "text": "秋ふかき野辺の嵐やさそうらん此男けて大類紅葉かな",
   "kana": "",
   "speaker": "",
   "page": 15,
   "pid": "nao-4395150",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "野外紅葉",
   "kotobagaki": ""
  },
  {
   "seq": "58",
   "text": "くれて行秋のかたみのゆふ露をやかてもさそふ風の音かな",
   "kana": "",
   "speaker": "",
   "page": 15,
   "pid": "nao-4395150",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "此里ふけ野外春秋風"
  },
  {
   "seq": "59",
   "text": "旅衣木葉ちりしく山風のしはし夢かす時もまもなし",
   "kana": "",
   "speaker": "",
   "page": 15,
   "pid": "nao-4395150",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "旅宿落葉",
   "kotobagaki": ""
  },
  {
   "seq": "60",
   "text": "かたしきのいつもつれなき松の色をこらみかほにも行時雨哉",
   "kana": "",
   "speaker": "",
   "page": 16,
   "pid": "nao-4395150",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "夢かす非先達所詠新儀也岸時雨"
  },
  {
   "seq": "61",
   "text": "おふ空のさゆる霜夜の月影は汀の松もあはれなりける",
   "kana": "",
   "speaker": "",
   "page": 16,
   "pid": "nao-4395150",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "汀霜",
   "kotobagaki": ""
  },
  {
   "seq": "62",
   "text": "旅人の松の嵐をさきたてゝ岩ふむ山にしくれすくなり",
   "kana": "",
   "speaker": "",
   "page": 16,
   "pid": "nao-4395150",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "霜の哥は常のならひは朝霜は暁なとは霜のみゆるやうに候也夜は不審も類ハなきさにて候也行路嵐"
  },
  {
   "seq": "63",
   "text": "まれにあくる泪の岩戸をよひよほに苔のとむしろ嵐吹出り",
   "kana": "",
   "speaker": "",
   "page": 16,
   "pid": "nao-4395150",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "時雨列過いつも嘆の外の物ハ候まし此類も凡水冬夜洞中嵐"
  },
  {
   "seq": "64",
   "text": "一冬かれの草の上葉に霜をへて見し世にもにぬ武蔵野の原",
   "kana": "",
   "speaker": "",
   "page": 16,
   "pid": "nao-4395150",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "古跡寒草",
   "kotobagaki": ""
  },
  {
   "seq": "65",
   "text": "みつしほの音もふけゐの浦風にこほれる月に千鳥おくなり",
   "kana": "",
   "speaker": "",
   "page": 16,
   "pid": "nao-4395150",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "古跡荒涼の題にて候へとたゝ古はみたる所にて候ハゝ名所野ハ不叶歟海寒月"
  },
  {
   "seq": "66",
   "text": "夕暮は霜さへわたるあしかもを上はにこほる月の影哉",
   "kana": "",
   "speaker": "",
   "page": 16,
   "pid": "nao-4395150",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "これも御と寒月にて候はゝ千鳥は不叶候夕水鳥"
  },
  {
   "seq": "67",
   "text": "冬くれは霰降なり住吉のはま松かえに花も咲けり",
   "kana": "",
   "speaker": "",
   "page": 17,
   "pid": "nao-4395150",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "夕と申題には月はいたく夜に成はてゝ候なりする染の夕とて日は入かた月は玉ぬほと候てよみ候歟漬霰"
  },
  {
   "seq": "68",
   "text": "一久かたの空すむ月しさむけれはむすほゝれ行苦の下水",
   "kana": "",
   "speaker": "",
   "page": 17,
   "pid": "nao-4395150",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "あられをも玉敷くたくなと申花とは読なしはさす候也あるへき体の事なき物にて候へは相似候苔造氷"
  },
  {
   "seq": "69",
   "text": "香の夜に汀の千鳥うちわひて鳴音さひしきさほの河風",
   "kana": "",
   "speaker": "",
   "page": 17,
   "pid": "nao-4395150",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "これも題の第五句に候いたくさかり候也雪中千馬"
  },
  {
   "seq": "70",
   "text": "ううみのみつれる沢への雪の中におなし色なる鶴の毛衣",
   "kana": "",
   "speaker": "",
   "page": 17,
   "pid": "nao-4395150",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "源氏哥霜寒汀の千鳥うちわひて明童さひしき朝ほらけかな古分の詞おなし句にすへたるは其度ときこゑ候なり雲中鶴"
  },
  {
   "seq": "71",
   "text": "こきよせてとまる汀木さひしさも今一しほの松の香折",
   "kana": "",
   "speaker": "",
   "page": 17,
   "pid": "nao-4395150",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "旅泊雪",
   "kotobagaki": ""
  },
  {
   "seq": "72",
   "text": "たのめてもまつはかひなき雪のよに吹さへたえぬ里の杉村",
   "kana": "",
   "speaker": "",
   "page": 18,
   "pid": "nao-4395150",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "汀いつくにも候へけれと池水なとには今すこし申ならひて候旅泊とまりの名所なとあらまほしく候雪中林"
  },
  {
   "seq": "73",
   "text": "一御吉野やうき世の里もいたつらに今年もくれぬとふ人はなし",
   "kana": "",
   "speaker": "",
   "page": 18,
   "pid": "nao-4395150",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "林はきはめたる難題也よみにくき物にてえなりさとの杉村にては林と聞え候まし古郷歳暮"
  },
  {
   "seq": "74",
   "text": "一花の色に染てし袖も朽にけりつれなき人を待とせたまに",
   "kana": "",
   "speaker": "",
   "page": 18,
   "pid": "nao-4395150",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄色恋五首",
   "kotobagaki": ""
  },
  {
   "seq": "75",
   "text": "夕まくれ草の上葉におく露の染てと人に逢よしもかな",
   "kana": "",
   "speaker": "",
   "page": 18,
   "pid": "nao-4395150",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "寄色恋心えぬ題にて候此五首たるはすもあらめとも心ゆきて覚候はす寄色恋と申さは花の末つむ花やしほの衣紫の一もとゆい山吹の花也衣月草の花染衣くちなしにちしほやろしほ黒かみの見たれて物をか様の事を読れ候へき歟"
  },
  {
   "seq": "76",
   "text": "月影のめくりあふへき契たにしらぬおもひに身を心かへてん",
   "kana": "",
   "speaker": "",
   "page": 18,
   "pid": "nao-4395150",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "77",
   "text": "一人心いかにそむらん初時雨筆の葉出して色かはりけり",
   "kana": "",
   "speaker": "",
   "page": 18,
   "pid": "nao-4395150",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "78",
   "text": "みやま辺や薄をしなみふる雪にきへてもものをおもふ此哉",
   "kana": "",
   "speaker": "",
   "page": 19,
   "pid": "nao-4395150",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "79",
   "text": "鴻庵の露みその露やそえつらん物思ふ初色そかわれる",
   "kana": "",
   "speaker": "",
   "page": 19,
   "pid": "nao-4395150",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄都計恋五首",
   "kotobagaki": ""
  },
  {
   "seq": "80",
   "text": "月影に嶺立ならす麻の音色おもひたそふは夜半そかなしき",
   "kana": "",
   "speaker": "",
   "page": 19,
   "pid": "nao-4395150",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "寄声とては月庵もこゑをかれ候へきか"
  },
  {
   "seq": "81",
   "text": "おもひとひ夜半の衣を返しつゝ松にゆえかることの山風",
   "kana": "",
   "speaker": "",
   "page": 19,
   "pid": "nao-4395150",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "82",
   "text": "もしほやく浦の月波こゑはてゝなかぬはかりそ袖は乾かす",
   "kana": "",
   "speaker": "",
   "page": 19,
   "pid": "nao-4395150",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "83",
   "text": "一金のめつゝ詩夜明行鳥の春はいけ物とや人の知らん",
   "kana": "",
   "speaker": "",
   "page": 19,
   "pid": "nao-4395150",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "84",
   "text": "うらみのみかさなる山のさよ衣ふりても袖のかひやなからん",
   "kana": "",
   "speaker": "",
   "page": 19,
   "pid": "nao-4395150",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "一人のしるらん心ゆかす寄雑物恋五首"
  },
  {
   "seq": "85",
   "text": "一備のうき夜な〳〵を焚の戸にうらみをそふる嶺の木枯",
   "kana": "",
   "speaker": "とも心えす",
   "page": 19,
   "pid": "nao-4395150",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "衣は雑物に可然歌い"
  },
  {
   "seq": "86",
   "text": "知るといふのけのを枕ともあらはかもふ心を人につけこせ",
   "kana": "",
   "speaker": "",
   "page": 19,
   "pid": "nao-4395150",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "戸は非難物",
   "kotobagaki": ""
  },
  {
   "seq": "87",
   "text": "みせはやな詩歌あけゆ也鐘の音に渡うちそふ聲けしきを",
   "kana": "",
   "speaker": "",
   "page": 19,
   "pid": "nao-4395150",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "戸は非難物",
   "kotobagaki": ""
  },
  {
   "seq": "88",
   "text": "行舟のなかれあふやこそのみつゝ涙の河に身をや捨なん",
   "kana": "",
   "speaker": "",
   "page": 19,
   "pid": "nao-4395150",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "戸は非難物",
   "kotobagaki": ""
  },
  {
   "seq": "89",
   "text": "一岩代の野中の松も露落てむすひそめけん昔恋らし",
   "kana": "",
   "speaker": "",
   "page": 19,
   "pid": "nao-4395150",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "古松",
   "kotobagaki": ""
  },
  {
   "seq": "90",
   "text": "一時やらぬ窓うつ雨もふかき夜の枕にのこる秋のと通し火",
   "kana": "",
   "speaker": "",
   "page": 20,
   "pid": "nao-4395150",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "残灯",
   "kotobagaki": ""
  },
  {
   "seq": "91",
   "text": "一鏡山のとけた月の有明に君かは千代共影をしるかな",
   "kana": "",
   "speaker": "",
   "page": 20,
   "pid": "nao-4395150",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "残灯",
   "kotobagaki": ""
  },
  {
   "seq": "92",
   "text": "山ひめの霞にしほるゝ月雲のころもかけほす霞の松へ",
   "kana": "",
   "speaker": "",
   "page": 20,
   "pid": "nao-4395150",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "白雲",
   "kotobagaki": ""
  },
  {
   "seq": "93",
   "text": "なし給へておもふもかなし音へ山たか身のまても嶺の白雲",
   "kana": "",
   "speaker": "こしけおれすは",
   "page": 20,
   "pid": "nao-4395150",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "露にしほるゝ白雲す無常"
  },
  {
   "seq": "94",
   "text": "身にしみて物そかなしきふるき世のむかし忍の里の秋かせ",
   "kana": "",
   "speaker": "",
   "page": 20,
   "pid": "nao-4395150",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄名所述懐",
   "kotobagaki": ""
  },
  {
   "seq": "95",
   "text": "津の国やなにわの浦のほかも頼君なき里は住うかりけり",
   "kana": "",
   "speaker": "",
   "page": 20,
   "pid": "nao-4395150",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄名所述懐",
   "kotobagaki": ""
  },
  {
   "seq": "96",
   "text": "小倉山わか身一日の秋なれや春の風にもぬるゝ袖哉",
   "kana": "",
   "speaker": "",
   "page": 20,
   "pid": "nao-4395150",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄名所述懐",
   "kotobagaki": ""
  },
  {
   "seq": "97",
   "text": "雨ふれは下葉のこらずもる山や物おもふ袖の秋の秋の夕書",
   "kana": "",
   "speaker": "",
   "page": 20,
   "pid": "nao-4395150",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄名所述懐",
   "kotobagaki": ""
  },
  {
   "seq": "98",
   "text": "しつみ行うき身よいかに涙川行来しらぬ浪の上の月",
   "kana": "",
   "speaker": "",
   "page": 20,
   "pid": "nao-4395150",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄名所述懐",
   "kotobagaki": ""
  },
  {
   "seq": "99",
   "text": "いかならんうき身のはてをしら浪のまよふもかなしすまの浦風",
   "kana": "",
   "speaker": "",
   "page": 20,
   "pid": "nao-4395150",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄名所述懐",
   "kotobagaki": ""
  },
  {
   "seq": "100",
   "text": "身のうきをかくとも誰に石見かたおもひみたるゝ浪い音かな",
   "kana": "",
   "speaker": "",
   "page": 20,
   "pid": "nao-4395150",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄名所述懐",
   "kotobagaki": ""
  },
  {
   "seq": "101",
   "text": "もしほ汲まとをの衣風はやみからみつきせぬ時浄白浪",
   "kana": "",
   "speaker": "",
   "page": 20,
   "pid": "nao-4395150",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄名所述懐",
   "kotobagaki": ""
  },
  {
   "seq": "102",
   "text": "山いく年月もよそにの見へたつる亥に物やおもはん",
   "kana": "",
   "speaker": "",
   "page": 20,
   "pid": "nao-4395150",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄名所述懐",
   "kotobagaki": ""
  },
  {
   "seq": "103",
   "text": "とにかくにかゝるうき世にせかの山おもひもして猶三寸哉",
   "kana": "",
   "speaker": "",
   "page": 20,
   "pid": "nao-4395150",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄名所述懐",
   "kotobagaki": ""
  },
  {
   "seq": "104",
   "text": "とそなる人のおやの親のかきけることの葉を子の子の世まてみるもおつかし",
   "kana": "",
   "speaker": "真華無疑候",
   "page": 21,
   "pid": "nao-4395150",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄名所述懐",
   "kotobagaki": ""
  }
 ],
